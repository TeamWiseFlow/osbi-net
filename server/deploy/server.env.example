# NOTE (2026-11-23): the retired osbi_server used these variables. The
# current wiseflow_server reads channels/stores/nodes from runtime.yaml:
#   OSBI_CONFIG_FILE=/etc/osbi-net/runtime.yaml
#   OSBI_LLM_API_KEY=...
# Legacy variable names below are retained only as operator overrides.

OSBI_SERVER_DATA=/var/lib/osbi-server
OSBI_LLM_BASE_URL=https://api.siliconflow.cn/v1
OSBI_LLM_API_KEY=
OSBI_SELECTED_MODEL=deepseek-ai/DeepSeek-V3.2
OSBI_INFO_MODEL=Qwen/Qwen3-32B
OSBI_ONTOLOGY_MODEL=Qwen/Qwen3.5-27B
OSBI_FALLBACK_MODEL=deepseek-ai/DeepSeek-V3.2
OSBI_GRAPH_PROCESSING_MODE=continuous
OSBI_GRAPH_BATCH_WINDOW=02:00-06:00
OSBI_GRAPH_BATCH_TIMEZONE=Asia/Shanghai
OSBI_MODEL_CONCURRENCY=3
OSBI_MODEL_TIMEOUT=120
# Optional JSON system-prompt overrides; see server/README.md.
OSBI_PROMPTS_FILE=
# Optional JSON retention policy; defaults and protected references are documented in server/README.md.
OSBI_RETENTION_FILE=
# Use the ops control plane in production; no local-key fallback in this mode.
OSBI_AUTH_MODE=supabase
OSBI_CONTROL_URL=http://127.0.0.1:8000
OSBI_CONTROL_KEY=
