@prefix : <https://osbi.net/schema/generic#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Fixed generic vocabulary. Changes require an explicit administrator revision.
:Organization a owl:Class ; rdfs:label "机构组织" .
:Person a owl:Class ; rdfs:label "人物" .
:Event a owl:Class ; rdfs:label "事件" .
:Place a owl:Class ; rdfs:label "地点" .
:Document a owl:Class ; rdfs:label "文件" .
:Concept a owl:Class ; rdfs:label "概念议题" .
:participatesIn a owl:ObjectProperty ; rdfs:label "参与" ;
    rdfs:domain :Organization, :Person ; rdfs:range :Event .
:issues a owl:ObjectProperty ; rdfs:label "发布" ;
    rdfs:domain :Organization, :Person ; rdfs:range :Document .
:locatedIn a owl:ObjectProperty ; rdfs:label "位于" ;
    rdfs:domain :Organization, :Event ; rdfs:range :Place .
:mentions a owl:ObjectProperty ; rdfs:label "提及" ;
    rdfs:domain :Document, :Event ; rdfs:range :Organization, :Person, :Concept, :Place .
